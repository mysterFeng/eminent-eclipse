---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import PostGrid from "../../components/PostGrid.astro";
import { getCollection } from "astro:content";
import { deslugTag } from "../../utils/slug";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) =>
    import.meta.env.DEV ? true : !data.draft
  );
  const normalizeCategory = (value) =>
    typeof value === "string" ? value.trim() : "";
  const categories = Array.from(
    new Set(
      posts
        .map((p) =>
          normalizeCategory(p.data.categoryCustom) ||
          normalizeCategory(p.data.category)
        )
        .filter((c) => c.length > 0)
    )
  );
  return categories.map((category) => ({
    params: { category },
  }));
}

const { category } = Astro.params;
const posts = await getCollection("posts", ({ data }) =>
  import.meta.env.DEV ? true : !data.draft
);
const normalizeCategory = (value) =>
  typeof value === "string" ? value.trim() : "";
const getCategory = (post) =>
  normalizeCategory(post.data.categoryCustom) ||
  normalizeCategory(post.data.category);
const allCategories = Array.from(new Set(posts.map((p) => getCategory(p))));
const rawCategory = decodeURIComponent(category ?? "");
const categoryLabel = deslugTag(rawCategory, allCategories);
const getOrderFromTitle = (title = "") => {
  const match = title.match(/^(\d{1,3})\./);
  return match ? Number(match[1]) : Number.POSITIVE_INFINITY;
};
const filtered = posts
  .filter((p) => getCategory(p) === categoryLabel)
  .map((entry) => ({ ...entry.data, href: `/posts/${entry.slug}` }))
  .sort((a, b) => {
    const orderA = getOrderFromTitle(a.title);
    const orderB = getOrderFromTitle(b.title);
    if (orderA !== orderB) return orderA - orderB;
    return a.title.localeCompare(b.title, "zh-Hans-CN");
  });
---
<BaseLayout title={`分类 · ${categoryLabel}`}>
  <SiteHeader
    links={[
      { href: "/", label: "首页" },
      { href: "/posts", label: "归档" },
      { href: "/tags", label: "标签" },
    ]}
  />

  <main class="container">
    <section class="post-grid">
      <header class="section-head">
        <h3 data-num="CAT">{categoryLabel}</h3>
      </header>
      <PostGrid posts={filtered} showHeader={false} />
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
