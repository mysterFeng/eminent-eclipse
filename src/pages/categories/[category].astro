---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import PostGrid from "../../components/PostGrid.astro";
import { getCollection } from "astro:content";
import { deslugTag, slugifyTag } from "../../utils/slug";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) =>
    import.meta.env.DEV ? true : !data.draft
  );
  const categories = Array.from(
    new Set(posts.map((p) => p.data.category))
  );
  return categories.map((category) => ({
    params: { category: slugifyTag(category) },
  }));
}

const { category } = Astro.params;
const posts = await getCollection("posts", ({ data }) =>
  import.meta.env.DEV ? true : !data.draft
);
const getCategory = (post) =>
  post.data.categoryCustom?.trim()
    ? post.data.categoryCustom.trim()
    : post.data.category;
const allCategories = Array.from(new Set(posts.map((p) => getCategory(p))));
const rawCategory = decodeURIComponent(category ?? "");
const categoryLabel = deslugTag(rawCategory, allCategories);
const filtered = posts
  .filter((p) => slugifyTag(getCategory(p)) === slugifyTag(categoryLabel))
  .map((entry) => ({ ...entry.data, href: `/posts/${entry.slug}` }))
  .sort((a, b) => (a.date < b.date ? 1 : -1));
---
<BaseLayout title={`分类 · ${categoryLabel}`}>
  <SiteHeader
    links={[
      { href: "/", label: "首页" },
      { href: "/posts", label: "归档" },
      { href: "/tags", label: "标签" },
    ]}
  />

  <main class="container">
    <section class="post-grid">
      <header class="section-head">
        <h3>分类：{categoryLabel}</h3>
      </header>
      <PostGrid posts={filtered} showHeader={false} />
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
