---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { getCollection } from "astro:content";
import { slugifyTag } from "../../utils/slug";

const posts = await getCollection("posts", ({ data }) =>
  import.meta.env.DEV ? true : !data.draft
);
const getCategory = (post) =>
  post.data.categoryCustom?.trim()
    ? post.data.categoryCustom.trim()
    : post.data.category;
const categories = Array.from(new Set(posts.map((p) => getCategory(p)))).sort();
---
<BaseLayout title="分类">
  <SiteHeader
    links={[
      { href: "/", label: "首页" },
      { href: "/posts", label: "归档" },
      { href: "/tags", label: "标签" },
    ]}
  />

  <main class="container tags-page">
    <section class="topics">
      <h3>全部分类</h3>
      <p>按分类查看文章。</p>
      <div class="topic-pills">
        {categories.map((category) =>
          slugifyTag(category) ? (
            <a href={`/categories/${encodeURIComponent(slugifyTag(category))}`}>{category}</a>
          ) : null
        )}
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
