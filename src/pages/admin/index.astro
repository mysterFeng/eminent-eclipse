<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>内容管理</title>
    <style>
      body {
        font-family: "Manrope", system-ui, -apple-system, sans-serif;
        background: #0f1115;
        color: #f5f5f5;
        margin: 0;
        min-height: 100vh;
      }
      .admin-shell {
        position: fixed;
        inset: 0;
      }
      .admin-hint {
        position: fixed;
        top: 16px;
        right: 16px;
        background: rgba(15, 17, 21, 0.8);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: #f5f5f5;
        padding: 10px 14px;
        border-radius: 999px;
        font-size: 12px;
        z-index: 9999;
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .admin-hint a {
        color: #4cc7b9;
        text-decoration: none;
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <div class="admin-shell" id="cms-root"></div>
    <div class="admin-hint">
      <span>管理员入口</span>
      <a href="/">返回首页</a>
    </div>
    <script is:inline src="/admin/decap-cms.js"></script>
  </body>
</html>
