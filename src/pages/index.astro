---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Hero from "../components/Hero.astro";
import FeaturedSection from "../components/FeaturedSection.astro";
import Topics from "../components/Topics.astro";
import PostGrid from "../components/PostGrid.astro";
import Newsletter from "../components/Newsletter.astro";
import { getCollection } from "astro:content";

const isDev = import.meta.env.DEV;

const allPosts = await getCollection("posts", ({ data }) =>
  isDev ? true : !data.draft
);
const sorted = allPosts
  .map((entry) => ({
    ...entry.data,
    href: `/posts/${entry.slug}`,
  }))
  .sort((a, b) => (a.date < b.date ? 1 : -1));
const getCategory = (post) =>
  post.categoryCustom?.trim() ? post.categoryCustom.trim() : post.category;
const featured = sorted.find((p) => p.featured) ?? sorted[0];
const recent = sorted.slice(0, 4);
const categories = Array.from(
  new Set(
    sorted
      .map((p) => getCategory(p))
      .filter((c) => typeof c === "string" && c.trim().length > 0)
  )
).sort();
---
<BaseLayout title="个人博客 · 首页">
  <SiteHeader
    links={[
      { href: "#featured", label: "精选" },
      { href: "#posts", label: "文章" },
      { href: "#topics", label: "分类" },
      { href: "/posts", label: "归档" },
      { href: "/tags", label: "标签" },
    ]}
  />

  <main class="container">
    <Hero />
    <FeaturedSection featured={featured} recent={recent} />
    <Topics tags={categories} basePath="/categories" />
    <PostGrid posts={sorted} />
    <Newsletter />
  </main>

  <SiteFooter />
</BaseLayout>
