---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import PostGrid from "../../components/PostGrid.astro";
import Pagination from "../../components/Pagination.astro";
import { getCollection } from "astro:content";

const isDev = import.meta.env.DEV;

const allPosts = await getCollection("posts", ({ data }) =>
  isDev ? true : !data.draft
);
const sorted = allPosts
  .map((entry) => ({ ...entry.data, href: `/posts/${entry.slug}` }))
  .sort((a, b) => (a.date < b.date ? 1 : -1));
const getCategory = (post) =>
  post.categoryCustom?.trim() ? post.categoryCustom.trim() : post.category;
const grouped = sorted.reduce((acc, post) => {
  const category = getCategory(post)?.trim() || "未分类";
  if (!acc[category]) acc[category] = [];
  acc[category].push(post);
  return acc;
}, {});
const groupEntries = Object.entries(grouped).sort((a, b) => a[0].localeCompare(b[0]));
const getOrderFromTitle = (title = "") => {
  const match = title.match(/^(\d{1,3})\./);
  return match ? Number(match[1]) : Number.POSITIVE_INFINITY;
};

export async function getStaticPaths({ paginate }) {
  const posts = await getCollection("posts", ({ data }) =>
    import.meta.env.DEV ? true : !data.draft
  );
  const sorted = posts
    .map((entry) => ({ ...entry.data, href: `/posts/${entry.slug}` }))
    .sort((a, b) => (a.date < b.date ? 1 : -1));
  return paginate(sorted, { pageSize: 6 });
}

const page =
  Astro.props.page ?? {
    data: sorted,
    currentPage: 1,
    lastPage: 1,
    url: { prev: null, next: null },
  };
---
<BaseLayout title={`文章归档 · 第 ${page.currentPage} 页`}>
  <SiteHeader
    links={[
      { href: "/", label: "首页" },
      { href: "/posts", label: "归档" },
      { href: "/tags", label: "标签" },
    ]}
  />

  <main class="container archive-layout">
    <aside class="archive-sidebar" aria-label="归档目录">
      <div class="archive-sticky">
        <h4>分类目录</h4>
        <nav class="archive-tree">
          {groupEntries.map(([category, posts], index) => {
            const orderedPosts = [...posts].sort((a, b) => {
              const orderA = getOrderFromTitle(a.title);
              const orderB = getOrderFromTitle(b.title);
              if (orderA !== orderB) return orderA - orderB;
              return a.title.localeCompare(b.title, "zh-Hans-CN");
            });
            return (
            <details class="archive-group" open={index === 0}>
              <summary>
                <span>{category}</span>
                <em>{posts.length}</em>
              </summary>
              <div class="archive-items">
                {orderedPosts.map((post) => (
                  <a href={post.href}>{post.title}</a>
                ))}
              </div>
            </details>
            );
          })}
        </nav>
      </div>
    </aside>

    <section class="post-grid">
      <header class="section-head">
        <h3>全部文章</h3>
      </header>
      <PostGrid posts={page.data} showHeader={false} />
      <Pagination page={page} />
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
