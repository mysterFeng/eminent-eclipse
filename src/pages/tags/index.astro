---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts", ({ data }) =>
  import.meta.env.DEV ? true : !data.draft
);
const tags = Array.from(
  new Set(posts.flatMap((p) => p.data.tags))
)
  .filter((tag) => typeof tag === "string" && tag.trim().length > 0)
  .sort();
const normalizeCategory = (value) =>
  typeof value === "string" ? value.trim() : "";
const getCategory = (post) =>
  normalizeCategory(post.data.categoryCustom) ||
  normalizeCategory(post.data.category);
const categories = Array.from(
  new Set(
    posts
      .map((p) => getCategory(p))
      .filter((c) => c.length > 0)
  )
).sort();
---
<BaseLayout title="标签">
  <SiteHeader
    links={[
      { href: "/", label: "首页" },
      { href: "/posts", label: "归档" },
      { href: "/tags", label: "标签" },
    ]}
  />

  <main class="container tags-page">
    <section class="topics">
      <h3>全部分类</h3>
      <div class="topic-pills">
        {categories.map((category) =>
          category?.trim() ? (
            <a href={`/categories/${encodeURIComponent(category)}`}>{category}</a>
          ) : null
        )}
      </div>
    </section>

    <section class="topics">
      <h3>全部标签</h3>
      <div class="topic-pills">
        {tags.map((tag) => (
          <a href={`/tags/${encodeURIComponent(tag)}`}>{tag}</a>
        ))}
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
