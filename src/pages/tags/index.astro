---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts", ({ data }) =>
  import.meta.env.DEV ? true : !data.draft
);
const tags = Array.from(
  new Set(posts.flatMap((p) => p.data.tags))
)
  .filter((tag) => typeof tag === "string" && tag.trim().length > 0)
  .sort();
const normalizeCategory = (value) =>
  typeof value === "string" ? value.trim() : "";
const getCategory = (post) =>
  normalizeCategory(post.data.categoryCustom) ||
  normalizeCategory(post.data.category);
const categories = Array.from(
  new Set(
    posts
      .map((p) => getCategory(p))
      .filter((c) => c.length > 0)
  )
).sort();
---
<BaseLayout title="标签">
  <SiteHeader
    links={[
      { href: "/", label: "首页" },
      { href: "/posts", label: "归档" },
      { href: "/tags", label: "标签" },
    ]}
  />

  <main class="container tags-page">
    <section class="topics">
      <h3>全部分类</h3>
      <div class="topic-pills">
        {categories.map((category) =>
          category?.trim() ? (
            <a href={`/categories/${encodeURIComponent(category)}`}>{category}</a>
          ) : null
        )}
      </div>
    </section>

    <section class="topics">
      <h3>全部标签</h3>
      <div class="tag-search">
        <input
          type="search"
          placeholder="搜索标签"
          aria-label="搜索标签"
          autocomplete="off"
          data-tag-search
        />
        <span class="tag-count" data-tag-count></span>
      </div>
      <div class="topic-pills" data-tag-list>
        {tags.map((tag) => (
          <a href={`/tags/${encodeURIComponent(tag)}`} data-tag={tag.toLowerCase()}>
            {tag}
          </a>
        ))}
      </div>
      <p class="tag-empty" data-tag-empty hidden>没有匹配的标签</p>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<script type="module">
  const input = document.querySelector("[data-tag-search]");
  const list = document.querySelector("[data-tag-list]");
  const empty = document.querySelector("[data-tag-empty]");
  const count = document.querySelector("[data-tag-count]");

  if (input && list) {
    const items = Array.from(list.querySelectorAll("a"));
    const update = () => {
      const query = input.value.trim().toLowerCase();
      let visible = 0;
      items.forEach((item) => {
        const text = (item.dataset.tag || item.textContent || "").toLowerCase();
        const match = query.length === 0 || text.includes(query);
        item.style.display = match ? "" : "none";
        if (match) visible += 1;
      });
      if (empty) empty.hidden = visible !== 0;
      if (count) count.textContent = query ? `匹配 ${visible} 个` : `共 ${items.length} 个`;
    };
    input.addEventListener("input", update);
    update();
  }
</script>
