---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import PostGrid from "../../components/PostGrid.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) =>
    import.meta.env.DEV ? true : !data.draft
  );
  const tags = Array.from(
    new Set(
      posts
        .flatMap((p) => p.data.tags)
        .filter((t) => typeof t === "string" && t.trim().length > 0)
    )
  );
  return tags.map((tag) => ({ params: { tag } }));
}

const posts = await getCollection("posts", ({ data }) =>
  import.meta.env.DEV ? true : !data.draft
);
const rawTagParam = Astro.params.tag ?? "";
let tag = rawTagParam;
try {
  tag = decodeURIComponent(rawTagParam);
} catch (error) {
  tag = rawTagParam;
}
const filtered = posts
  .filter((p) => p.data.tags.includes(tag))
  .map((entry) => ({ ...entry.data, href: `/posts/${entry.slug}` }))
  .sort((a, b) => (a.date < b.date ? 1 : -1));
---
<BaseLayout title={`标签 · ${tag}`}>
  <SiteHeader
    links={[
      { href: "/", label: "首页" },
      { href: "/posts", label: "归档" },
      { href: "/tags", label: "标签" },
    ]}
  />

  <main class="container">
    <section class="post-grid">
      <header class="section-head">
        <h3 data-num="TAG">{tag}</h3>
      </header>
      <PostGrid posts={filtered} showHeader={false} />
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
