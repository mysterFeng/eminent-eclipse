---
const { tags = [], basePath = "/categories" } = Astro.props;
---
<section class="topics" id="topics">
  <h3 data-num="02">分类</h3>
  <div class="topic-pills">
    {tags.map((tag) =>
      tag?.trim() ? (
        <a href={`${basePath}/${encodeURIComponent(tag)}`}>{tag}</a>
      ) : null
    )}
  </div>
</section>
