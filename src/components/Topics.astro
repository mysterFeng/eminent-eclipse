---
import { slugifyTag } from "../utils/slug";
const { tags = [], basePath = "/categories" } = Astro.props;
---
<section class="topics" id="topics">
  <h3>分类</h3>
  <div class="topic-pills">
    {tags.map((tag) =>
      slugifyTag(tag) ? (
        <a href={`${basePath}/${encodeURIComponent(slugifyTag(tag))}`}>{tag}</a>
      ) : null
    )}
  </div>
</section>
