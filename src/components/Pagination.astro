---
const { page } = Astro.props;
---
<nav class="pagination">
  {page.url.prev ? <a class="btn btn-ghost" href={page.url.prev}>上一页</a> : <span></span>}
  <span class="meta">第 {page.currentPage} / {page.lastPage} 页</span>
  {page.url.next ? <a class="btn btn-ghost" href={page.url.next}>下一页</a> : <span></span>}
</nav>
