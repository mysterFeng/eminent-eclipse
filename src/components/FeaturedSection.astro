---
const { featured, recent } = Astro.props;
---
<section class="featured-section" id="featured">
  <header class="section-head">
    <h3 data-num="01">精选</h3>
    <a class="btn btn-ghost" href="/posts">所有文章</a>
  </header>

  <div class="featured">
    <article class="featured-card">
      <div class="featured-content">
        <p class="eyebrow">Featured</p>
        <h2>{featured.title}</h2>
        <p class="excerpt">{featured.summary ?? featured.description}</p>
        <div class="meta">{featured.date} · {featured.author}</div>
        <a class="btn" href={featured.href}>阅读全文</a>
      </div>
    </article>

    <aside class="recent-list">
      <h3>最新更新</h3>
      {recent.map((item) => (
        <a class="recent-item" href={item.href}>
          <span class="title">{item.title}</span>
          <span class="meta">{item.date}</span>
        </a>
      ))}
    </aside>
  </div>
</section>
