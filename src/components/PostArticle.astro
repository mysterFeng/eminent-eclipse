---
import { slugifyTag } from "../utils/slug";
const { post } = Astro.props;
---
<article class="post-article">
  <header class="post-head">
    <p class="eyebrow">精选文章</p>
    <h1>{post.title}</h1>
    <div class="meta">{post.readingTime} · {post.date} · {post.tags?.[0]}</div>
    <div class="post-tags">
      {post.tags?.map((tag) => (
        <a href={`/tags/${slugifyTag(tag)}`}>{tag}</a>
      ))}
    </div>
  </header>

  <div class="post-cover">
    <div
      class="cover-art"
      style={post.cover ? `background-image:url(${post.cover}); background-size:cover; background-position:center;` : undefined}
    ></div>
  </div>

  <div class="post-body">
    <slot />
  </div>

  <section class="author">
    <div class="author-avatar">JH</div>
    <div>
      <h4>作者简介</h4>
      <p>专注于内容创作、产品策略与设计实践。欢迎交流合作。</p>
    </div>
  </section>

  <section class="post-nav">
    <a class="btn btn-ghost" href="#">上一篇</a>
    <a class="btn" href="#">下一篇</a>
  </section>
</article>
