---
const { links = [] } = Astro.props;
---
<header class="site-header">
  <div class="container nav">
    <div class="logo">JJ</div>
    <nav class="nav-links">
      {links.map((link) => {
        const isHash = link.href?.startsWith("#");
        return (
          <a
            class={`nav-link${isHash ? " nav-anchor" : ""}`}
            href={link.href}
            data-target={isHash ? link.href.slice(1) : undefined}
            data-path={!isHash ? link.href : undefined}
          >
            {link.label}
          </a>
        );
      })}
    </nav>
  </div>
</header>
